# Required: create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=123456:replace_me

# Security: start with this empty, run the bridge, send /id to the bot, then set your numeric user ID and restart.
TELEGRAM_ALLOWED_USER_IDS=
# Optional: additionally restrict exact chats/groups. Empty means any chat used by an allowed user.
TELEGRAM_ALLOWED_CHAT_IDS=

# Prime Agent executable and the local workspace it may operate on.
PRIME_AGENT_BIN=prime-agent
PRIME_WORKDIR=/absolute/path/to/your/prime/workspace

# Optional Prime overrides. Empty = use Prime Agent's existing/default provider/model auth and selection.
PRIME_PROVIDER=
PRIME_MODEL=
# Valid: off, minimal, low, medium, high, xhigh, max
PRIME_THINKING=medium

# Bridge-owned state. Prime's own auth remains in ~/.prime and is never copied here.
BRIDGE_STATE_DIR=~/.prime/telegram
PRIME_SESSION_DIR=~/.prime/telegram/sessions
# Maximum bytes accepted for one Prime JSONL RPC frame. Default: 16 MiB.
PRIME_RPC_MAX_LINE_BYTES=16777216

TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_MAX_ATTACHMENT_BYTES=20971520
# Staged Telegram documents are purged after this many hours.
TELEGRAM_ATTACHMENT_RETENTION_HOURS=24
LOG_LEVEL=INFO
