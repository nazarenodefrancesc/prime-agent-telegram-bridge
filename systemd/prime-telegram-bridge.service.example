[Unit]
Description=Prime Agent Telegram Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/prime-telegram-bridge/env
WorkingDirectory=%h/prime-agent-telegram-bridge
ExecStart=%h/prime-agent-telegram-bridge/.venv/bin/prime-telegram-bridge
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target
