[Unit]
Description=Prime Agent Telegram Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/prime-telegram-bridge/env
ExecStart=%h/.local/bin/prime-telegram-bridge
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target
